# ─────────────────────────────────────────
#  Configuração do banco de dados
#  Copie este arquivo para .env e preencha
# ─────────────────────────────────────────

DB_HOST=localhost
DB_PORT=5432
DB_NAME=hardware_db
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui

# Pool de conexões da API (05_api.py)
DB_POOL_MIN=2
DB_POOL_MAX=20

# ─────────────────────────────────────────
#  Notificações do agendador (04_scheduler.py)
#  Deixe em branco para desativar cada uma
# ─────────────────────────────────────────

SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
NOTIFY_EMAIL=

# ─────────────────────────────────────────
#  Agendador
# ─────────────────────────────────────────

# Qual robô o job "completo mensal" executa (deixe como está,
# a menos que você tenha renomeado o arquivo)
ROBO_SCRIPT=02_robo_cadastro_cpus.py
PYTHON_BIN=python

# ─────────────────────────────────────────
#  pgAdmin (opcional, apenas perfil "dev")
# ─────────────────────────────────────────

PGADMIN_PASSWORD=admin123
